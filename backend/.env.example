# 复制为 .env 后填写真实值（.env 不入库）
# LLM 提供方：stub（默认，无需密钥，使用种子数据的结构化叙述） | openai
LLM_PROVIDER=stub
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- 分用途网关（可选）：抽取要便宜快，对话/综述要质量 ----
# EXTRACT_BASE_URL=https://api.deepseek.com/v1
# EXTRACT_MODEL=deepseek-chat
# EXTRACT_API_KEY=sk-...
# CHAT_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# CHAT_API_KEY=sk-...

# ---- LLM 调用行为（不同模型差异很大，全部可在 .env 调，改完重启即生效）----
# 推理型模型（token 全被 reasoning 吃掉、content 恒空）必须关思考；
# 非推理型模型不认该参数时会自动降级重试，所以保持 1 也安全。
LLM_DISABLE_THINKING=1
# 单次调用硬超时（秒）。网关偶发挂死，SDK 默认不超时会拖死批处理
LLM_TIMEOUT=90
# 全局调用最小间隔（秒）：RPS 配额低时调大（如 3~6），配额宽松可设 0
LLM_MIN_INTERVAL=1.5
# 空响应 / 429 / 超时的重试次数
LLM_MAX_RETRY=2
# 部分模型只接受 temperature=1（如 kimi-k3）
LLM_TEMPERATURE=0.2
# 抽取单块送入原文上限（字）：给太多 → 输出 JSON 变长 → 被 max_tokens 截断
LLM_EXTRACT_INPUT_CHARS=6000
# 抽取输出预算：须 ≥ 输入能催生的 JSON token 量，否则 finish_reason=length
LLM_EXTRACT_MAX_TOKENS=8000
# 对话/综述输出预算（0 = 不限制）
LLM_CHAT_MAX_TOKENS=4096
